# Copy to `.env` beside docker-compose.yml and edit. Compose reads it
# automatically; `.env` is gitignored because SPORE_PASSPHRASE belongs in it.
#
#   cp .env.example .env && $EDITOR .env && docker compose up -d

# What the site is called. Part of the infohash, so changing it makes a
# different site — pick it once. Without this it defaults to the mount point
# and every site in the world published this way is called "site".
SPORE_SITE_NAME=my-site

# Which of *your* sites this is. A key is an author and an author has many
# sites, so this is the series an update addresses: your blog and your CV
# publish under one key without either replacing the other. Lower-case, no
# spaces. Defaults to SPORE_SITE_NAME.
SPORE_SITE=my-site

# The name your key claims for itself, shown to readers beside its fingerprint.
# Anyone can claim any name, and gates display it as a claim — the fingerprint
# is what actually identifies you. Leave blank to publish under the key alone.
SPORE_NAME=

# Your signing passphrase. THIS IS THE KEY: it is turned into one, never
# stored, never sent, and nobody can reset it. Without it the site is served
# but can never be updated — readers have no key to check a successor against.
#
# Use a long phrase you use nowhere else. Keep this file readable only by you:
#   chmod 600 .env
SPORE_PASSPHRASE=

# How often to look for edits, in seconds. Every change publishes a new version
# and offers it to readers still on the old one. 0 turns watching off, so
# versions are only published on restart.
SPORE_WATCH_SECONDS=30

# How many versions to keep seeding. Each is a full frozen copy of the site, so
# this is a disk budget — but it is also who can still be *told* about an
# update, since only a peer holding an old version can hand the news to someone
# reading it.
SPORE_KEEP_VERSIONS=10

# Health endpoint. `curl localhost:8081` reports every version and whether it
# actually verifies. 0 disables it, which also disables the container's
# healthcheck.
SPORE_STATUS_PORT=8081
