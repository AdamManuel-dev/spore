        </mxCell>
        <mxCell id="r-e9" edge="1" parent="1" source="r-normal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;" target="r-sw" value="HTTP fetch">
          <mxGeometry relative="1" x="-0.3" as="geometry">
