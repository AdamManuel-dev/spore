        <mxCell id="r-e10" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;entryX=0.5;entryY=1;fontSize=10;" target="r-sw" value="HTTP fetch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="510" />
              <mxPoint x="690" y="510" />
            </Array>
            <mxPoint x="400" y="510" as="sourcePoint" />
